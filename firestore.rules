rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownerEmail() {
      return signedIn() &&
        request.auth.token.email in ['aadhish.mahendran@gmail.com'];
    }

    function userOwnsProfile(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function approvedUid(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.approved == true;
    }

    function approvedUser(uid) {
      return signedIn() && request.auth.uid == uid && approvedUid(uid);
    }

    // Rules cannot iterate lists. Bound profile lookups to the per-write limit.
    function approvedMembers(members) {
      return members is list && members.size() <= 10
        && (members.size() < 1 || approvedUid(members[0]))
        && (members.size() < 2 || approvedUid(members[1]))
        && (members.size() < 3 || approvedUid(members[2]))
        && (members.size() < 4 || approvedUid(members[3]))
        && (members.size() < 5 || approvedUid(members[4]))
        && (members.size() < 6 || approvedUid(members[5]))
        && (members.size() < 7 || approvedUid(members[6]))
        && (members.size() < 8 || approvedUid(members[7]))
        && (members.size() < 9 || approvedUid(members[8]))
        && (members.size() < 10 || approvedUid(members[9]));
    }

    function validGroupName(name) {
      return name is string && name.size() > 0 && name.size() <= 80
        && name.matches('[\\s\\S]*\\S[\\s\\S]*');
    }

    function hasInvitedEmail() {
      return signedIn() &&
        exists(/databases/$(database)/documents/invites/$(request.auth.token.email));
    }

    function profileKeys() {
      return [
        'uid',
        'email',
        'displayName',
        'photoURL',
        'lastLoginAt',
        'lastSeenAt',
        'onlineStatus',
        'isOnline',
        'updatedAt',
        'approved',
        'role',
        'approvedAt',
        'approvedBy'
      ];
    }

    function validProfileBasics(uid) {
      return request.resource.data.keys().hasOnly(profileKeys())
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.photoURL is string
        && request.resource.data.onlineStatus in ['online', 'away', 'offline']
        && request.resource.data.isOnline is bool;
    }

    function validSelfProfileCreate(uid) {
      return userOwnsProfile(uid)
        && validProfileBasics(uid)
        && (
          (ownerEmail() && request.resource.data.approved == true && request.resource.data.role == 'owner') ||
          (!ownerEmail() && hasInvitedEmail() && request.resource.data.approved == true && request.resource.data.role == 'member') ||
          (!ownerEmail() && request.resource.data.approved == false && request.resource.data.role == 'pending')
        );
    }

    function validSelfProfileUpdate(uid) {
      return userOwnsProfile(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName',
          'photoURL',
          'lastLoginAt',
          'lastSeenAt',
          'onlineStatus',
          'isOnline',
          'updatedAt'
        ])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.onlineStatus in ['online', 'away', 'offline']
        && request.resource.data.isOnline is bool;
    }

    function validSelfInviteApproval(uid) {
      return userOwnsProfile(uid)
        && !ownerEmail()
        && hasInvitedEmail()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName',
          'photoURL',
          'lastLoginAt',
          'lastSeenAt',
          'onlineStatus',
          'isOnline',
          'updatedAt',
          'approved',
          'role',
          'approvedAt',
          'approvedBy'
        ])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.approved == true
        && request.resource.data.role == 'member'
        && request.resource.data.approvedBy is string
        && request.resource.data.onlineStatus in ['online', 'away', 'offline']
        && request.resource.data.isOnline is bool;
    }

    function validSelfPendingMigration(uid) {
      return userOwnsProfile(uid)
        && !ownerEmail()
        && !('approved' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName',
          'photoURL',
          'lastLoginAt',
          'lastSeenAt',
          'onlineStatus',
          'isOnline',
          'updatedAt',
          'approved',
          'role'
        ])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.approved == false
        && request.resource.data.role == 'pending'
        && request.resource.data.onlineStatus in ['online', 'away', 'offline']
        && request.resource.data.isOnline is bool;
    }

    function ownerWriteUserProfile(uid) {
      return ownerEmail()
        && request.resource.data.keys().hasOnly(profileKeys())
        && request.resource.data.uid == uid
        && request.resource.data.approved is bool
        && request.resource.data.role in ['owner', 'member', 'pending'];
    }

    function validConversationParticipants(data) {
      return approvedUser(request.auth.uid)
        && data.participants is list
        && data.participants.size() == 2
        && data.participants[0] != data.participants[1]
        && data.participants.hasAny([request.auth.uid])
        && approvedUid(data.participants[0])
        && approvedUid(data.participants[1]);
    }

    function validConversationCreate(data) {
      return data.keys().hasOnly(['participants', 'updatedAt'])
        && validConversationParticipants(data);
    }

    function validConversationUpdate() {
      return userIsParticipant()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt'])
        && request.resource.data.participants == resource.data.participants;
    }

    function userIsParticipant() {
      return approvedUser(request.auth.uid)
        && request.auth.uid in resource.data.participants;
    }

    function validSenderIdentity() {
      return approvedUser(request.auth.uid)
        && request.resource.data.keys().hasOnly(['text', 'senderUid', 'senderEmail', 'senderDisplayName', 'senderPhotoURL', 'participants', 'readBy', 'timestamp'])
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.senderEmail == request.auth.token.email
        && request.resource.data.senderDisplayName is string
        && request.resource.data.senderPhotoURL is string
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 4000
        && (!('deleted' in request.resource.data) || request.resource.data.deleted == false)
        && request.resource.data.readBy is list
        && request.resource.data.timestamp == request.time
        && request.resource.data.readBy.hasOnly([request.auth.uid]);
    }

    function validReadReceiptUpdate() {
      return approvedUser(request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
        && request.resource.data.readBy is list
        && (!('readBy' in resource.data) || request.resource.data.readBy.hasAll(resource.data.readBy))
        && request.resource.data.readBy.toSet().difference(resource.data.get('readBy', []).toSet()).hasOnly([request.auth.uid])
        && request.resource.data.readBy.hasAny([request.auth.uid]);
    }

    function validSenderMessageUpdate() {
      return approvedUser(request.auth.uid)
        && resource.data.senderUid == request.auth.uid
        && resource.data.get('deleted', false) != true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'edited', 'deleted'])
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 4000
        && (!('edited' in request.resource.data) || request.resource.data.edited is bool)
        && (
          (request.resource.data.get('deleted', false) == true && request.resource.data.text == '') ||
          (request.resource.data.get('deleted', false) == false && request.resource.data.text.size() > 0)
        );
    }

    function validMessageConversation(conversationId) {
      return exists(/databases/$(database)/documents/conversations/$(conversationId))
        && get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants.hasAny([request.auth.uid])
        && get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants == request.resource.data.participants;
    }

    function validConversationReadReceiptUpdate(conversationId) {
      return validReadReceiptUpdate()
        && exists(/databases/$(database)/documents/conversations/$(conversationId))
        && get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants.hasAny([request.auth.uid]);
    }

    function groupHasSignedInUser(data) {
      return (('memberIds' in data) && data.memberIds is list && data.memberIds.hasAny([request.auth.uid])) ||
        (('members' in data) && data.members is list && data.members.hasAny([request.auth.uid])) ||
        (('participants' in data) && data.participants is list && data.participants.hasAny([request.auth.uid]));
    }

    function groupCreator(data) {
      return (('createdBy' in data) && data.createdBy == request.auth.uid) ||
        (('creatorId' in data) && data.creatorId == request.auth.uid) ||
        (('creatorUid' in data) && data.creatorUid == request.auth.uid) ||
        (('ownerId' in data) && data.ownerId == request.auth.uid) ||
        (('ownerUid' in data) && data.ownerUid == request.auth.uid);
    }

    function groupHost(data) {
      return (('hostId' in data) && data.hostId == request.auth.uid) ||
        (('hostUid' in data) && data.hostUid == request.auth.uid);
    }

    function groupAdmin(data) {
      return (('adminIds' in data) && data.adminIds is list && data.adminIds.hasAny([request.auth.uid])) ||
        (('adminUids' in data) && data.adminUids is list && data.adminUids.hasAny([request.auth.uid])) ||
        (('adminId' in data) && data.adminId == request.auth.uid) ||
        (('adminUid' in data) && data.adminUid == request.auth.uid);
    }

    function groupManager(data) {
      return approvedUser(request.auth.uid)
        && (
          groupCreator(data) ||
          groupHost(data) ||
          groupAdmin(data)
        );
    }

    function groupNameEditor(data) {
      return approvedUser(request.auth.uid) && (groupManager(data) || groupHasSignedInUser(data));
    }

    function userIsGroupParticipant() {
      return approvedUser(request.auth.uid)
        && groupHasSignedInUser(resource.data);
    }

    function groupParticipant(groupId) {
      return approvedUser(request.auth.uid)
        && exists(/databases/$(database)/documents/groups/$(groupId))
        && groupHasSignedInUser(get(/databases/$(database)/documents/groups/$(groupId)).data);
    }

    function groupMessageViewer(groupId) {
      return groupParticipant(groupId)
        || (
          approvedUser(request.auth.uid)
          && exists(/databases/$(database)/documents/groups/$(groupId))
          && groupManager(get(/databases/$(database)/documents/groups/$(groupId)).data)
        );
    }

    function validGroupCreate() {
      return approvedUser(request.auth.uid)
        && request.resource.data.keys().hasOnly(['groupName', 'type', 'memberIds', 'members', 'participants', 'createdBy', 'creatorId', 'createdAt', 'updatedAt', 'hostId', 'adminIds', 'hostUid', 'adminUids'])
        && validGroupName(request.resource.data.groupName)
        && request.resource.data.type == 'group'
        && request.resource.data.memberIds is list
        && request.resource.data.members is list
        && request.resource.data.participants is list
        && request.resource.data.memberIds.size() == request.resource.data.members.size()
        && request.resource.data.members.size() >= 2
        && request.resource.data.members.size() == request.resource.data.members.toSet().size()
        && approvedMembers(request.resource.data.members)
        && request.resource.data.participants.size() == request.resource.data.members.size()
        && request.resource.data.memberIds == request.resource.data.members
        && request.resource.data.members == request.resource.data.participants
        && request.resource.data.memberIds.hasAny([request.auth.uid])
        && request.resource.data.members.hasAny([request.auth.uid])
        && request.resource.data.participants.hasAny([request.auth.uid])
        && request.resource.data.createdBy == request.auth.uid
        && (!('creatorId' in request.resource.data) || request.resource.data.creatorId == request.auth.uid)
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.adminIds is list
        && request.resource.data.adminIds == [request.auth.uid]
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.adminUids is list
        && request.resource.data.adminUids == [request.auth.uid]
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function validGroupUpdate() {
      return validGroupNameUpdate() || validGroupMembershipUpdate();
    }

    function validGroupNameUpdate() {
      return approvedUser(request.auth.uid)
        && groupNameEditor(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['groupName', 'updatedAt'])
        && validGroupName(request.resource.data.groupName);
    }

    function validGroupMembershipUpdate() {
      let added = request.resource.data.members.removeAll(resource.data.get('members', []))
        .removeAll(resource.data.get('memberIds', [])).removeAll(resource.data.get('participants', []));
      return approvedUser(request.auth.uid)
        && groupManager(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'members', 'participants', 'updatedAt'])
        && request.resource.data.memberIds is list
        && request.resource.data.members is list
        && request.resource.data.participants is list
        && request.resource.data.memberIds == request.resource.data.members
        && request.resource.data.members == request.resource.data.participants
        && request.resource.data.members.size() == request.resource.data.members.toSet().size()
        && added.size() <= 9
        && approvedMembers(added)
        && (!('memberIds' in resource.data) || request.resource.data.memberIds.hasAll(resource.data.memberIds))
        && (!('members' in resource.data) || request.resource.data.members.hasAll(resource.data.members))
        && (!('participants' in resource.data) || request.resource.data.participants.hasAll(resource.data.participants));
    }

    function validGroupDelete() {
      return groupManager(resource.data);
    }

    function validGroupMessageDelete(groupId) {
      return approvedUser(request.auth.uid)
        && exists(/databases/$(database)/documents/groups/$(groupId))
        && groupManager(get(/databases/$(database)/documents/groups/$(groupId)).data);
    }

    function validGroupMessage(groupId) {
      return validSenderIdentity() && groupParticipant(groupId);
    }

    function joinRequestKeys() {
      return [
        'groupId',
        'groupName',
        'uid',
        'email',
        'displayName',
        'photoURL',
        'createdBy',
        'hostId',
        'adminIds',
        'managerIds',
        'status',
        'requestedAt',
        'updatedAt',
        'decidedBy',
        'decidedAt'
      ];
    }

    function joinRequestManager(data) {
      return data.groupId is string
        && exists(/databases/$(database)/documents/groups/$(data.groupId))
        && groupManager(get(/databases/$(database)/documents/groups/$(data.groupId)).data);
    }

    function groupManagerIds(data) {
      return [data.get('createdBy', ''), data.get('creatorId', ''), data.get('creatorUid', ''),
          data.get('ownerId', ''), data.get('ownerUid', ''), data.get('hostId', ''),
          data.get('hostUid', ''), data.get('adminId', ''), data.get('adminUid', '')].toSet()
        .union(data.get('adminIds', []).toSet()).union(data.get('adminUids', []).toSet())
        .difference([''].toSet());
    }

    function canReadGroupJoinRequest() {
      return approvedUser(request.auth.uid)
        && (
          resource.data.uid == request.auth.uid ||
          joinRequestManager(resource.data)
        );
    }

    function validGroupJoinRequestCreate(requestId) {
      let group = get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data;
      return approvedUser(request.auth.uid)
        && request.resource.data.keys().hasOnly(joinRequestKeys())
        && request.resource.data.groupId is string
        && requestId == request.resource.data.groupId + '_' + request.auth.uid
        && exists(/databases/$(database)/documents/groups/$(request.resource.data.groupId))
        && !groupHasSignedInUser(get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.photoURL is string
        && request.resource.data.groupName is string
        && request.resource.data.createdBy is string
        && request.resource.data.hostId is string
        && request.resource.data.adminIds is list
        && request.resource.data.managerIds is list
        && request.resource.data.managerIds.size() > 0
        && request.resource.data.createdBy == group.get('createdBy', group.get('creatorId', group.get('creatorUid', group.get('ownerId', group.get('ownerUid', '')))))
        && request.resource.data.hostId == group.get('hostId', group.get('hostUid', request.resource.data.createdBy))
        && request.resource.data.adminIds.toSet() == [group.get('adminId', ''), group.get('adminUid', '')].toSet()
          .union(group.get('adminIds', []).toSet()).union(group.get('adminUids', []).toSet()).difference([''].toSet())
        && request.resource.data.managerIds.toSet() == groupManagerIds(group)
        && request.resource.data.managerIds.size() == groupManagerIds(group).size()
        && request.resource.data.status == 'pending';
    }

    function validGroupJoinDecision() {
      return approvedUser(request.auth.uid)
        && resource.data.groupId is string
        && resource.data.status == 'pending'
        && exists(/databases/$(database)/documents/groups/$(resource.data.groupId))
        && joinRequestManager(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedBy', 'decidedAt', 'updatedAt'])
        && request.resource.data.groupId == resource.data.groupId
        && request.resource.data.groupName == resource.data.groupName
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.displayName == resource.data.displayName
        && request.resource.data.photoURL == resource.data.photoURL
        && (!('createdBy' in resource.data) || request.resource.data.createdBy == resource.data.createdBy)
        && (!('hostId' in resource.data) || request.resource.data.hostId == resource.data.hostId)
        && (!('adminIds' in resource.data) || request.resource.data.adminIds == resource.data.adminIds)
        && (!('managerIds' in resource.data) || request.resource.data.managerIds == resource.data.managerIds)
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.decidedBy == request.auth.uid
        && (request.resource.data.status == 'rejected' ||
          getAfter(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.memberIds.hasAny([resource.data.uid]));
    }

    match /users/{uid} {
      allow read: if ownerEmail() || userOwnsProfile(uid) || (approvedUser(request.auth.uid) && resource.data.approved == true);
      allow create: if validSelfProfileCreate(uid) || ownerWriteUserProfile(uid);
      allow update: if validSelfProfileUpdate(uid) || validSelfInviteApproval(uid) || validSelfPendingMigration(uid) || ownerWriteUserProfile(uid);
      allow delete: if false;
    }

    match /invites/{email} {
      allow read: if ownerEmail() || (signedIn() && email == request.auth.token.email);
      allow create, update: if ownerEmail();
      allow delete: if ownerEmail();
    }

    match /conversations/{conversationId} {
      allow read: if userIsParticipant();
      allow create: if validConversationCreate(request.resource.data);
      allow update: if validConversationUpdate();
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if approvedUser(request.auth.uid)
          && exists(/databases/$(database)/documents/conversations/$(conversationId))
          && get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants.hasAny([request.auth.uid]);
        allow create: if validSenderIdentity()
          && validMessageConversation(conversationId)
          && request.resource.data.participants.hasAny([request.auth.uid]);
        allow update: if validConversationReadReceiptUpdate(conversationId)
          || (validSenderMessageUpdate() && validMessageConversation(conversationId));
        allow delete: if false;
      }
    }

    match /groups/{groupId} {
      allow read: if approvedUser(request.auth.uid);
      allow create: if validGroupCreate();
      allow update: if validGroupUpdate();
      allow delete: if validGroupDelete();

      match /messages/{messageId} {
        allow read: if groupMessageViewer(groupId);
        allow create: if validGroupMessage(groupId);
        allow update: if groupParticipant(groupId) && (validReadReceiptUpdate() || validSenderMessageUpdate());
        allow delete: if validGroupMessageDelete(groupId);
      }
    }

    match /groupJoinRequests/{requestId} {
      allow read: if canReadGroupJoinRequest();
      allow create: if validGroupJoinRequestCreate(requestId);
      allow update: if validGroupJoinRequestCreate(requestId) || validGroupJoinDecision();
      allow delete: if false;
    }

    match /groupMembers/{document=**} {
      allow read, write: if false;
    }

    match /invitations/{document=**} {
      allow read, write: if false;
    }

    match /approvedUsers/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
